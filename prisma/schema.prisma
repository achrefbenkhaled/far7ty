generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvitationStatus {
  DRAFT
  PREVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
}

model Invitation {
  id          String           @id @default(cuid())
  slug        String           @unique
  previewToken String          @unique @default(cuid())
  templateId  String
  status      InvitationStatus @default(DRAFT)
  clientName  String
  clientPhone String
  clientEmail String?
  eventType   String
  data        Json
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  publishedAt DateTime?

  @@index([status])
  @@index([updatedAt])
}